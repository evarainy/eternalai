# WARNING: placeholder-only example.
# Do not put real credentials, tokens, private mirror URLs, or environment-
# specific secrets in this file.
#
# Actual mirror addresses must be obtained from the internal environment or
# package administrator and supplied outside version control.

# Python package mirror placeholders for pip/uv.
# PIP_INDEX_URL=https://example.invalid/pypi/simple
# UV_INDEX_URL=https://example.invalid/pypi/simple

# ── Fixed local test database ───────────────────────────────────
# DATABASE_URL=<set locally to the fixed local test database; see tests/db/README.md>

# npm/pnpm registry placeholder. Prefer environment-local configuration.
# NPM_CONFIG_REGISTRY=https://example.invalid/npm/

# ── PostgreSQL (core-infra) ─────────────────────────────────────
POSTGRES_USER=eternalai
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eternalai
POSTGRES_PORT=5432

# ── Redis (core-infra) ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Langfuse (observability) ────────────────────────────────────
LANGFUSE_PORT=3000
LANGFUSE_PUBLIC_KEY=placeholder_public_key
LANGFUSE_SECRET_KEY=placeholder_secret_key
LANGFUSE_NEXTAUTH_SECRET=placeholder_nextauth_secret
LANGFUSE_SALT=placeholder_salt

# ── OpenTelemetry Collector (observability) ─────────────────────
OTEL_COLLECTOR_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# ── App (app) ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

# Production composition. Supply real values outside version control.
# OA_BASE_URL=https://oa.example.invalid
# OA_TIMEOUT_S=30
# OA_CREDENTIAL_TTL_S=<positive-seconds>
# OA_READ_ADAPTER_MODE=replay
# OA_READ_CONTRACT_PACK_DIR=./path/to/sanitized-oa-contract-pack
# OA_PENDING_WORKFLOWS_CONTRACT_PACK_DIR=./tests/contract_packs/oa/ecology9-pending-workflows-v2
# OA_SYSTEM_MESSAGES_CONTRACT_PACK_DIR=./path/to/system-messages-pack
# OA_MESSAGE_CENTER_PATH=/placeholder/message-center-list
# OA_PENDING_WORKFLOWS_CATEGORY_ID=<onsite-confirmed-category-id>
# OA_PENDING_WORKFLOWS_BIZSTATE=<onsite-confirmed-value-or-empty>
# OA_PENDING_WORKFLOWS_SELECT_STATE=<onsite-confirmed-value-or-empty>
# OA_SYSTEM_MESSAGES_CATEGORY_ID=<onsite-confirmed-category-id-or-empty-for-all>
# OA_SYSTEM_MESSAGES_BIZSTATE=<onsite-confirmed-value-or-empty>
# OA_SYSTEM_MESSAGES_SELECT_STATE=<onsite-confirmed-value-or-empty>
# OA_MESSAGE_CENTER_PAGE_SIZE=20
# SESSION_COOKIE_TTL_S=<positive-seconds>
# Required with no default; set one or more comma-separated canonical application origins.
CSRF_ALLOWED_ORIGINS=https://example.invalid
# ETERNALAI_CREDENTIAL_ENCRYPTION_KEY_B64=<base64-encoded-32-byte-key>
# ETERNALAI_IDENTITY_HMAC_KEY_B64=<base64-encoded-key-at-least-32-bytes>
# ETERNALAI_SESSION_SIGNING_KEY_B64=<base64-encoded-key-at-least-32-bytes>
# ETERNALAI_SESSION_BINDING_KEY_B64=<base64-encoded-key-at-least-32-bytes>
#
