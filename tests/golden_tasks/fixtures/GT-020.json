{
  "golden_task_id": "GT-020",
  "title": "Workflow IO 映射与条件分支正向闭环",
  "category": "positive",
  "given": {
    "ai_user_id": "user_employee_020",
    "roles": [
      "employee"
    ],
    "identity_mappings": [
      {
        "target_system": "u8",
        "binding_id": "bind_u8_020",
        "status": "active",
        "binding_scope": "acct_b4_020",
        "account_set_id": "acct_b4_020"
      }
    ],
    "registered_capabilities": [
      {
        "capability_id": "u8.workflow.b4_io_branch",
        "target_system": "u8",
        "type": "workflow",
        "risk_level": "low",
        "execution_identity": "user_delegated",
        "binding_required": false,
        "version": "1.0.0"
      },
      {
        "capability_id": "u8.b4.document.lookup",
        "target_system": "u8",
        "type": "query",
        "risk_level": "low",
        "execution_identity": "user_delegated",
        "binding_required": false
      },
      {
        "capability_id": "u8.b4.vendor.balance",
        "target_system": "u8",
        "type": "query",
        "risk_level": "low",
        "execution_identity": "user_delegated",
        "binding_required": false
      },
      {
        "capability_id": "u8.b4.branch.never",
        "target_system": "u8",
        "type": "query",
        "risk_level": "low",
        "execution_identity": "user_delegated",
        "binding_required": false
      }
    ],
    "workflow_definitions": [
      {
        "workflow_id": "u8.workflow.b4_io_branch",
        "version": "1.0.0",
        "steps": [
          {
            "step_id": "lookup_document",
            "capability_id": "u8.b4.document.lookup",
            "static_arguments": {
              "account_set_id": "acct_b4_020"
            },
            "input_mapping": {
              "document_no": {
                "source": "workflow_input",
                "key": "document_no"
              }
            }
          },
          {
            "step_id": "read_vendor_balance",
            "capability_id": "u8.b4.vendor.balance",
            "input_mapping": {
              "account_set_id": {
                "source": "step_output",
                "step_id": "lookup_document",
                "key": "account_set_id"
              }
            }
          },
          {
            "step_id": "voided_only_branch",
            "capability_id": "u8.b4.branch.never",
            "when": {
              "value": {
                "source": "step_output",
                "step_id": "lookup_document",
                "key": "document_status"
              },
              "equals": "voided"
            }
          }
        ]
      }
    ]
  },
  "when": {
    "channel": "web",
    "message": "执行 B4 IO 映射工作流",
    "arguments": {
      "document_no": "B4-DOC-020"
    }
  },
  "then_response": {
    "status": "completed",
    "envelope": {
      "data.account_set_id": "acct_b4_020",
      "data.vendor_id": "vendor-001",
      "ui.component_type": "none"
    }
  },
  "then_trace": {
    "event_sequence": [
      "task_created",
      "intent_parsed",
      "capability_selected",
      "capability_selected",
      "identity_check",
      "policy_checked",
      "adapter_called",
      "capability_selected",
      "identity_check",
      "policy_checked",
      "adapter_called",
      "capability_selected",
      "response_envelope_created",
      "task_completed"
    ],
    "event_details": [
      {
        "event_type": "capability_selected",
        "capability_id": "u8.b4.document.lookup",
        "attributes": {
          "workflow_id": "u8.workflow.b4_io_branch",
          "workflow_version": "1.0.0",
          "step_id": "lookup_document",
          "step_status": "running"
        }
      },
      {
        "event_type": "capability_selected",
        "capability_id": "u8.b4.vendor.balance",
        "attributes": {
          "workflow_id": "u8.workflow.b4_io_branch",
          "workflow_version": "1.0.0",
          "step_id": "read_vendor_balance",
          "step_status": "running"
        }
      },
      {
        "event_type": "capability_selected",
        "capability_id": "u8.b4.branch.never",
        "status": "skipped",
        "attributes": {
          "workflow_id": "u8.workflow.b4_io_branch",
          "workflow_version": "1.0.0",
          "step_id": "voided_only_branch",
          "step_status": "skipped"
        }
      }
    ]
  },
  "then_workflow": {
    "event_sequence": [
      "workflow_started",
      "workflow_step_finished",
      "workflow_step_finished",
      "workflow_step_finished",
      "workflow_completed"
    ],
    "workflow_version": "1.0.0",
    "step_statuses": [
      "completed",
      "completed",
      "skipped"
    ],
    "terminal_status": "completed"
  },
  "then_forbidden": [
    "trace_contains_token",
    "response_contains_internal_url"
  ],
  "mock_failure_injection": {
    "enabled": false,
    "mode": "none"
  },
  "adapter_assertion": {
    "must_be_called": true,
    "must_not_be_called": false,
    "exact_calls": {
      "u8.b4.document.lookup": 1,
      "u8.b4.vendor.balance": 1,
      "u8.b4.branch.never": 0
    },
    "exact_arguments": {
      "u8.b4.document.lookup": [
        {
          "account_set_id": "acct_b4_020",
          "document_no": "B4-DOC-020"
        }
      ],
      "u8.b4.vendor.balance": [
        {
          "account_set_id": "acct_b4_020"
        }
      ]
    }
  }
}
