    "workflow_version": "1.0.0",
    "step_statuses": [
      "timeout"
    ],
    "terminal_status": "timeout",
    "terminal_error_code": "adapter_timeout"
  },
  "then_forbidden": [
    "trace_contains_token",
    "response_data_not_null"
  ],
  "mock_failure_injection": {
    "enabled": false,
    "mode": "none",
    "expected_error_code": "adapter_timeout"
