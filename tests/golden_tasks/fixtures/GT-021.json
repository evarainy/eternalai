        "binding_scope": "default"
      }
    ],
    "registered_capabilities": [
      {
        "capability_id": "oa.workflow.b4_retry_timeout",
        "target_system": "oa",
        "type": "workflow",
        "risk_level": "low",
        "execution_identity": "user_delegated",
        "binding_required": false,
        "version": "1.0.0"
      },
      {
        "capability_id": "oa.b4.timeout.unstable",
        "target_system": "oa",
