  "then_trace": {
    "reason": "adapter_timeout",
    "event_sequence": [
      "task_created",
      "capability_selected",
      "capability_selected",
      "identity_check",
      "policy_checked",
      "adapter_called",
      "adapter_error_mapped",
      "capability_selected",
      "identity_check",
      "policy_checked",
      "adapter_called",
      "adapter_error_mapped",
      "response_envelope_created",
      "task_failed"
    ],
    "event_details": [
      {
        "event_type": "capability_selected",
        "capability_id": "oa.b4.timeout.unstable",
        "attributes": {
          "workflow_id": "oa.workflow.b4_retry_timeout",
          "workflow_version": "1.0.0",
          "step_id": "unstable",
          "step_status": "running",
          "attempt": 1,
          "max_attempts": 2
        }
      },
      {
        "event_type": "capability_selected",
        "capability_id": "oa.b4.timeout.unstable",
        "attributes": {
          "workflow_id": "oa.workflow.b4_retry_timeout",
          "workflow_version": "1.0.0",
          "step_id": "unstable",
          "step_status": "retrying",
          "attempt": 2,
          "max_attempts": 2
        }
      }
