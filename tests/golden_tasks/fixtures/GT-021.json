        "binding_required": false
      }
    ],
    "workflow_definitions": [
      {
        "workflow_id": "oa.workflow.b4_retry_timeout",
        "version": "1.0.0",
        "steps": [
          {
            "step_id": "unstable",
            "capability_id": "oa.b4.timeout.unstable"
          },
          {
            "step_id": "later",
            "capability_id": "oa.b4.timeout.later"
          }
        ]
