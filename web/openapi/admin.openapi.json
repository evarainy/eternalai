{
  "openapi": "3.0.3",
  "info": {
    "title": "EternalAI Admin Registry API",
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/admin/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "List Tasks by session or AI user",
        "parameters": [
          {
            "$ref": "#/components/parameters/RoleClaims"
          },
          {
            "name": "session_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ai_user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks matching the supplied filters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminTaskListResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "422": {
            "$ref": "#/components/responses/TaskFilterRequired"
          },
          "503": {
            "$ref": "#/components/responses/RegistryUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/tasks/{task_id}/events": {
      "get": {
        "operationId": "listTaskEvents",
        "summary": "List safe evidence for a Task",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          },
          {
            "$ref": "#/components/parameters/RoleClaims"
          }
        ],
        "responses": {
          "200": {
            "description": "Task events with allowlisted evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminTaskEventListResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "404": {
            "$ref": "#/components/responses/TaskNotFound"
          },
          "503": {
            "$ref": "#/components/responses/RegistryUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/bindings": {
      "get": {
        "operationId": "listBindings",
        "summary": "List identity bindings for an AI user",
        "parameters": [
          {
            "$ref": "#/components/parameters/RoleClaims"
          },
          {
            "name": "ai_user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target_system",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TargetSystem"
            }
          },
          {
            "name": "binding_scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "account_set_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "device_domain_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Identity bindings matching the supplied filters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminBindingListResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "422": {
            "$ref": "#/components/responses/BindingQueryInvalid"
          },
          "503": {
            "$ref": "#/components/responses/RegistryUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/bindings/{binding_id}/revoke": {
      "post": {
        "operationId": "revokeBinding",
        "summary": "Revoke an identity binding",
        "parameters": [
          {
            "$ref": "#/components/parameters/BindingId"
          }
        ],
        "responses": {
          "200": {
            "description": "Binding revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminBindingMutationResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "404": {
            "$ref": "#/components/responses/BindingNotFound"
          },
          "503": {
            "$ref": "#/components/responses/BindingMutationUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/bindings/{binding_id}/reset": {
      "post": {
        "operationId": "resetBinding",
        "summary": "Reset an identity binding",
        "parameters": [
          {
            "$ref": "#/components/parameters/BindingId"
          }
        ],
        "responses": {
          "200": {
            "description": "Binding reset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminBindingMutationResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "404": {
            "$ref": "#/components/responses/BindingNotFound"
          },
          "503": {
            "$ref": "#/components/responses/BindingMutationUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/registry": {
      "get": {
        "operationId": "listRegistry",
        "summary": "List Registry capabilities",
        "parameters": [
          {
            "$ref": "#/components/parameters/RoleClaims"
          }
        ],
        "responses": {
          "200": {
            "description": "Registry capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCapabilityListResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/RegistryUnavailable"
          }
        }
      },
      "post": {
        "operationId": "createCapability",
        "summary": "Create a draft Registry capability",
        "parameters": [
          {
            "$ref": "#/components/parameters/RoleClaims"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCapabilityCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft capability created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCapabilityView"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "422": {
            "description": "Request body validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FastApiValidationErrorResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/RegistryUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/registry/{capability_id}": {
      "get": {
        "operationId": "getCapability",
        "summary": "Get a Registry capability",
        "parameters": [
          {
            "$ref": "#/components/parameters/CapabilityId"
          },
          {
            "$ref": "#/components/parameters/RoleClaims"
          }
        ],
        "responses": {
          "200": {
            "description": "Registry capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCapabilityView"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "404": {
            "$ref": "#/components/responses/CapabilityNotFound"
          },
          "503": {
            "$ref": "#/components/responses/RegistryUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/registry/{capability_id}/enable": {
      "post": {
        "operationId": "enableCapability",
        "summary": "Enable a Registry capability",
        "parameters": [
          {
            "$ref": "#/components/parameters/CapabilityId"
          },
          {
            "$ref": "#/components/parameters/RoleClaims"
          }
        ],
        "responses": {
          "200": {
            "description": "Enabled Registry capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCapabilityView"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "404": {
            "$ref": "#/components/responses/CapabilityNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidStatusTransition"
          },
          "503": {
            "$ref": "#/components/responses/RegistryUnavailable"
          }
        }
      }
    },
    "/api/v1/admin/registry/{capability_id}/disable": {
      "post": {
        "operationId": "disableCapability",
        "summary": "Disable a Registry capability",
        "parameters": [
          {
            "$ref": "#/components/parameters/CapabilityId"
          },
          {
            "$ref": "#/components/parameters/RoleClaims"
          }
        ],
        "responses": {
          "200": {
            "description": "Disabled Registry capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminCapabilityView"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RoleNotAllowed"
          },
          "404": {
            "$ref": "#/components/responses/CapabilityNotFound"
          },
          "409": {
            "$ref": "#/components/responses/InvalidStatusTransition"
          },
          "503": {
            "$ref": "#/components/responses/RegistryUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TaskId": {
        "name": "task_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "BindingId": {
        "name": "binding_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CapabilityId": {
        "name": "capability_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RoleClaims": {
        "name": "X-EternalAI-Roles",
        "in": "header",
        "required": false,
        "description": "Unverified comma-separated role claims for Admin Lite.",
        "schema": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "responses": {
      "TaskFilterRequired": {
        "description": "A session_id or ai_user_id filter is required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      },
      "TaskNotFound": {
        "description": "The Task was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      },
      "BindingQueryInvalid": {
        "description": "The Binding query parameters are invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      },
      "BindingNotFound": {
        "description": "The Binding was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      },
      "BindingMutationUnavailable": {
        "description": "The Binding mutation provider is unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      },
      "RoleNotAllowed": {
        "description": "The declared roles are insufficient",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      },
      "CapabilityNotFound": {
        "description": "The capability was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      },
      "InvalidStatusTransition": {
        "description": "The requested status transition is invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      },
      "RegistryUnavailable": {
        "description": "The Admin Registry provider is unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "TaskStatus": {
        "type": "string",
        "enum": [
          "created",
          "running",
          "waiting_user",
          "completed",
          "failed",
          "no_capability_found"
        ]
      },
      "TargetSystem": {
        "type": "string",
        "enum": ["oa", "u8", "hikvision_ivms"]
      },
      "ExecutionIdentity": {
        "type": "string",
        "enum": ["user_delegated", "system_scope", "admin_approved_proxy"]
      },
      "IdentityBindStatus": {
        "type": "string",
        "enum": [
          "active",
          "unbound",
          "expired",
          "revoked",
          "verification_failed",
          "needs_binding_scope"
        ]
      },
      "AdminTaskView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "session_id",
          "ai_user_id",
          "status",
          "capability_id",
          "error_code"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "ai_user_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "capability_id": {
            "type": "string",
            "nullable": true
          },
          "error_code": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AdminTaskEventEvidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "selection_rule": {
            "type": "string"
          },
          "workflow_id": {
            "type": "string"
          },
          "workflow_version": {
            "type": "string"
          },
          "workflow_status": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          },
          "step_id": {
            "type": "string"
          },
          "step_index": {
            "type": "integer"
          },
          "step_status": {
            "type": "string"
          },
          "attempt": {
            "type": "integer"
          },
          "retry_number": {
            "type": "integer"
          },
          "max_attempts": {
            "type": "integer"
          },
          "waiting_step_id": {
            "type": "string"
          },
          "waiting_step_index": {
            "type": "integer"
          },
          "confirmed_capability_id": {
            "type": "string"
          },
          "completed_step_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "step_output_keys": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "recovery_input_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AdminTaskEventView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "task_id", "event_type", "timestamp", "evidence"],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "$ref": "#/components/schemas/AdminTaskEventEvidence"
          }
        }
      },
      "AdminBindingView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "target_system",
          "execution_identity",
          "bind_status",
          "binding_scope",
          "account_set_id",
          "device_domain_id",
          "reason_code"
        ],
        "properties": {
          "binding_id": {
            "type": "string",
            "nullable": true
          },
          "target_system": {
            "$ref": "#/components/schemas/TargetSystem"
          },
          "execution_identity": {
            "$ref": "#/components/schemas/ExecutionIdentity"
          },
          "bind_status": {
            "$ref": "#/components/schemas/IdentityBindStatus"
          },
          "binding_scope": {
            "type": "string",
            "nullable": true
          },
          "account_set_id": {
            "type": "string",
            "nullable": true
          },
          "device_domain_id": {
            "type": "string",
            "nullable": true
          },
          "reason_code": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AdminBindingMutationView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "target_system",
          "execution_identity",
          "bind_status",
          "binding_scope",
          "account_set_id",
          "device_domain_id",
          "reason_code"
        ],
        "properties": {
          "binding_id": {
            "type": "string"
          },
          "target_system": {
            "type": "string",
            "enum": ["oa"]
          },
          "execution_identity": {
            "type": "string",
            "enum": ["user_delegated"]
          },
          "bind_status": {
            "type": "string",
            "enum": ["revoked"]
          },
          "binding_scope": {
            "type": "string",
            "nullable": true,
            "enum": [null]
          },
          "account_set_id": {
            "type": "string",
            "nullable": true,
            "enum": [null]
          },
          "device_domain_id": {
            "type": "string",
            "nullable": true,
            "enum": [null]
          },
          "reason_code": {
            "type": "string",
            "enum": ["identity_revoked"]
          }
        }
      },
      "AdminBindingMutationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "binding", "changed", "next_action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["revoke", "reset"]
          },
          "binding": {
            "$ref": "#/components/schemas/AdminBindingMutationView"
          },
          "changed": {
            "type": "boolean"
          },
          "next_action": {
            "type": "string",
            "enum": ["none", "reauthenticate"]
          }
        }
      },
      "AdminTaskListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminTaskView"
            }
          }
        }
      },
      "AdminTaskEventListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminTaskEventView"
            }
          }
        }
      },
      "AdminBindingListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ai_user_id", "items"],
        "properties": {
          "ai_user_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminBindingView"
            }
          }
        }
      },
      "CapabilityType": {
        "type": "string",
        "enum": ["query", "action", "workflow", "mock"]
      },
      "CapabilityRiskLevel": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "CapabilityStatus": {
        "type": "string",
        "enum": ["draft", "active", "disabled", "deprecated"]
      },
      "CapabilityTargetSystem": {
        "type": "string",
        "enum": ["oa", "u8", "hikvision_ivms"],
        "nullable": true
      },
      "CapabilityExecutionIdentity": {
        "type": "string",
        "enum": ["user_delegated", "system_scope", "admin_approved_proxy"]
      },
      "CapabilityAutomationLevel": {
        "type": "string",
        "enum": ["full", "assisted", "manual"]
      },
      "WorkObjectHandlingSelector": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_system",
          "source_kind",
          "source_workflow_type_id"
        ],
        "properties": {
          "source_system": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          },
          "source_workflow_type_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AdminCapabilityCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "name",
          "type",
          "input_schema_digest",
          "output_schema_digest",
          "risk_level",
          "owner",
          "version",
          "short_description",
          "execution_identity",
          "binding_required"
        ],
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "$ref": "#/components/schemas/CapabilityType"
          },
          "intent_tags": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            },
            "default": []
          },
          "input_schema": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          },
          "output_schema": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          },
          "input_schema_digest": {
            "type": "string"
          },
          "output_schema_digest": {
            "type": "string"
          },
          "risk_level": {
            "$ref": "#/components/schemas/CapabilityRiskLevel"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "version": {
            "type": "string"
          },
          "short_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "target_system": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CapabilityTargetSystem"
              }
            ],
            "default": null
          },
          "execution_identity": {
            "$ref": "#/components/schemas/CapabilityExecutionIdentity"
          },
          "binding_required": {
            "type": "boolean"
          },
          "policy_digest": {
            "type": "string",
            "nullable": true,
            "default": null
          },
          "automation_level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CapabilityAutomationLevel"
              }
            ],
            "default": "manual"
          },
          "displayable_argument_fields": {
            "type": "array",
            "items": {
