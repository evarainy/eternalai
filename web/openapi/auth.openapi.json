{
  "components": {
    "schemas": {
      "LoginResponse": {
        "additionalProperties": false,
        "properties": {
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean"
          }
        },
        "required": [
          "authenticated"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "LogoutResponse": {
        "additionalProperties": false,
        "properties": {
          "authenticated": {
            "const": false,
            "default": false,
            "title": "Authenticated",
            "type": "boolean"
          }
        },
        "title": "LogoutResponse",
        "type": "object"
      },
      "RenewResponse": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "legacy",
                  "throttled",
                  "capped",
                  "principal_changed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionStatusResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "renewed",
              "unchanged",
              "ended"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "RenewResponse",
        "type": "object"
      },
      "SessionStatusResponse": {
        "additionalProperties": false,
        "description": "Deadlines of the presented ticket; ``absolute_expires_at`` null means no cap.",
        "properties": {
          "absolute_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Absolute Expires At"
          },
          "idle_expires_at": {
            "format": "date-time",
            "title": "Idle Expires At",
            "type": "string"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          }
        },
        "required": [
          "idle_expires_at",
          "absolute_expires_at",
          "server_time"
        ],
        "title": "SessionStatusResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "EternalAI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "One-shot OA login credential accepted only by the authentication adapter.",
                "properties": {
                  "loginid": {
                    "format": "password",
                    "title": "Loginid",
                    "type": "string",
                    "writeOnly": true
                  },
                  "userpassword": {
                    "format": "password",
                    "title": "Userpassword",
                    "type": "string",
                    "writeOnly": true
                  }
                },
                "required": [
                  "loginid",
                  "userpassword"
                ],
                "title": "LoginCredential",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Login"
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "CSRF validation failed"
          },
          "503": {
            "description": "Logout is temporarily unavailable"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/v1/auth/renew": {
      "post": {
        "operationId": "renew_api_v1_auth_renew_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenewResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "CSRF validation failed"
          },
          "503": {
            "description": "Renewal is temporarily unavailable"
          }
        },
        "summary": "Renew"
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "session_api_v1_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Authentication required"
          },
          "503": {
            "description": "Authentication is temporarily unavailable"
          }
        },
        "summary": "Session"
      }
    }
  }
}
