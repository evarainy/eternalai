            "title": "Media Type",
            "type": "string"
          },
          "size_bytes": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "media_type",
          "size_bytes",
          "expires_at",
          "availability"
        ],
        "title": "BrowserArtifactView",
        "type": "object"
      },
      "BrowserCancelRequest": {
