              "$ref": "#/components/schemas/ConversationMessage"
            },
            "title": "Messages",
            "type": "array"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "title",
          "messages"
        ],
        "title": "ConversationMessages",
        "type": "object"
      },
      "ConversationSummary": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "title",
          "updated_at"
        ],
        "title": "ConversationSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoryCard": {
        "properties": {
          "component_type": {
            "title": "Component Type",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "component_type"
        ],
        "title": "HistoryCard",
        "type": "object"
      },
      "HistoryEnvelope": {
        "properties": {
