          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "sheets": {
            "items": {
              "$ref": "#/components/schemas/SheetView"
            },
            "title": "Sheets",
            "type": "array"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "filename",
          "size_bytes",
          "sheets",
          "expires_at"
        ],
        "title": "ChatUploadResponse",
        "type": "object"
      },
      "FileArtifactErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
