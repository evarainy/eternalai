{
  "components": {
    "schemas": {
      "AuthorizationView": {
        "properties": {
          "authorization_url": {
            "title": "Authorization Url",
            "type": "string"
          }
        },
        "required": [
          "authorization_url"
        ],
        "title": "AuthorizationView",
        "type": "object"
      },
      "ConnectionView": {
        "properties": {
          "connection_id": {
            "title": "Connection Id",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "service_config_id": {
            "title": "Service Config Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "connection_id",
          "service_config_id",
          "state",
          "expires_at"
        ],
        "title": "ConnectionView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OperationView": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "argument_preview": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Argument Preview",
            "type": "object"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "preview_digest": {
            "title": "Preview Digest",
            "type": "string"
          },
          "recovery_action": {
            "enum": [
              "confirm",
              "recover",
              "read_original",
              "manual_reconcile",
              "takeover",
              "none"
            ],
            "title": "Recovery Action",
            "type": "string"
          },
          "review_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Url"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "service_config_id": {
            "title": "Service Config Id",
            "type": "string"
          },
          "service_name": {
            "title": "Service Name",
            "type": "string"
          },
          "state": {
            "enum": [
              "READY",
              "WAITING_LOCAL_CONFIRM",
              "WAITING_EXTERNAL_CONFIRM",
              "SENDING",
              "UNKNOWN",
              "VERIFIED_SUCCESS",
              "FAILED",
              "CANCELLED",
              "EXPIRED"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "service_config_id",
          "state",
          "revision",
          "expires_at",
          "action",
          "service_name",
          "argument_preview",
          "preview_digest",
          "recovery_action"
        ],
        "title": "OperationView",
        "type": "object"
      },
      "ResumeRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "confirm",
              "cancel",
              "recover",
              "reconcile",
              "takeover"
            ],
            "title": "Action",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "preview_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Preview Digest",
            "type": "string"
          }
        },
        "required": [
          "action",
          "expected_revision",
          "preview_digest"
        ],
        "title": "ResumeRequest",
        "type": "object"
      },
      "ServiceView": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "service_config_id": {
            "title": "Service Config Id",
            "type": "string"
          }
        },
        "required": [
          "service_config_id",
          "display_name",
          "enabled"
        ],
        "title": "ServiceView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
