{
  "components": {
    "schemas": {
      "BrowserOwnerScope": {
        "additionalProperties": false,
        "description": "Server HMAC cache aliases; never internal IDs or authorization grants.",
        "properties": {
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "user_id"
        ],
        "title": "BrowserOwnerScope",
        "type": "object"
      },
      "MeOrg": {
        "additionalProperties": false,
        "description": "Plain-text organization labels; never raw markup, never an upstream id.",
        "properties": {
          "department_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department Id"
          },
          "department_name": {
            "title": "Department Name",
            "type": "string"
          },
          "unit_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Id"
          },
          "unit_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Name"
          }
        },
        "required": [
          "department_name"
        ],
        "title": "MeOrg",
        "type": "object"
      },
      "MeResponse": {
        "additionalProperties": false,
        "description": "A 200 always means authenticated; ``org`` may still be absent.",
        "properties": {
          "authenticated": {
            "const": true,
            "default": true,
            "title": "Authenticated",
            "type": "boolean"
          },
          "avatar_path": {
            "anyOf": [
              {
                "const": "/api/v1/me/avatar",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Path"
          },
          "browser_owner_scope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BrowserOwnerScope"
              },
              {
                "type": "null"
              }
            ]
          },
          "browser_skill_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Browser Skill Id"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "org": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MeOrg"
              },
              {
                "type": "null"
              }
            ]
          },
          "org_status": {
            "enum": [
              "ok",
              "unbound",
              "expired",
              "unavailable",
              "unparsable"
            ],
            "title": "Org Status",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "org_status"
        ],
        "title": "MeResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "EternalAI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "read_me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Me"
      }
    },
    "/api/v1/me/avatar": {
      "get": {
        "operationId": "read_avatar_api_v1_me_avatar_get",
        "responses": {
          "200": {
            "content": {
              "image/gif": {},
              "image/jpeg": {},
              "image/png": {},
              "image/webp": {}
            },
            "description": "The caller's own avatar image."
          }
        },
        "summary": "Read Avatar"
      }
    }
  }
}
